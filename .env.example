# MuE Client Environment
# Copy to .env and fill in your backend URL.
#
# PRODUCTION (Render Blueprint):
EXPO_PUBLIC_API_URL=https://mue-backend.onrender.com
#
# LOCAL DEV (localhost):
# EXPO_PUBLIC_API_URL=http://localhost:4000
#
# LOCAL DEV (physical device on same LAN):
# EXPO_PUBLIC_API_URL=http://<your-LAN-IP>:4000
